{
  "expo": {
    "name": "ReniSocial",
    "slug": "ReniSocial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/logo-dark.png",
    "scheme": "renisocial",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icons/logo-dark.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001E88",
        "foregroundImage": "./assets/icons/logo-dark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.victoribk.ReniSocial"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/logo-dark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001E88",
          "image": "./assets/icons/logo-dark.png",
          "imageWidth": 60
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ReniSocial to access your photos to select workspace logos."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "887f8de6-a3a7-47a4-830e-612d97c1ed3e"
      }
    }
  }
}
